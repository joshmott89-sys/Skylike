  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action on pages and sheets.",
      "html": "<button class=\"ds-btn\">Save</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:14px;padding:12px 18px;min-height:48px;font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif);font-weight:700;font-size:17px;background:var(--ocean,#0B4F6C);color:#fff;transition:filter .15s,transform .1s;cursor:pointer}.ds-btn:hover{filter:brightness(1.08)}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:3px solid var(--ocean-2,#126C8F);outline-offset:2px}"
    },
    {
      "name": "Soft Button",
      "kind": "button",
      "refersTo": "button-soft",
      "description": "Secondary action on a foam field with the field lift.",
      "html": "<button class=\"ds-btn-soft\">Cancel</button>",
      "css": ".ds-btn-soft{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:14px;padding:12px 18px;min-height:48px;font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif);font-weight:700;font-size:17px;background:var(--surface,#F8FBFC);color:var(--ink,#10293A);box-shadow:var(--shadow,0 1px 2px rgba(0,0,0,.06),0 10px 28px -14px rgba(0,0,0,.22));transition:filter .15s,transform .1s;cursor:pointer}.ds-btn-soft:hover{filter:brightness(1.03)}.ds-btn-soft:active{transform:scale(.98)}.ds-btn-soft:focus-visible{outline:3px solid var(--ocean-2,#126C8F);outline-offset:2px}"
    },
    {
      "name": "Capture Button",
      "kind": "button",
      "refersTo": "button-capture",
      "description": "The single floating apricot add action.",
      "html": "<button class=\"ds-capture\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Add</button>",
      "css": ".ds-capture{border:0;border-radius:99px;background:var(--apricot,#F2A65A);color:#3D2208;font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif);font-weight:750;font-size:19px;padding:16px 24px 16px 18px;display:inline-flex;gap:10px;align-items:center;box-shadow:0 10px 26px -10px rgba(0,0,0,.35);cursor:pointer;transition:transform .1s}.ds-capture:active{transform:scale(.98)}.ds-capture:focus-visible{outline:3px solid var(--ocean-2,#126C8F);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled input on white water with an ocean focus stroke.",
      "html": "<label class=\"ds-field\"><span>List item</span><input class=\"ds-input\" placeholder=\"Add milk\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif)}.ds-field span{font-size:15px;font-weight:700;color:var(--ink-2,#46606F)}.ds-input{border:2px solid var(--line,rgba(0,0,0,.1));background:var(--raise,#fff);border-radius:14px;padding:12px 14px;min-height:50px;font:inherit;font-size:18px;color:var(--ink,#10293A);outline:none;transition:border-color .15s}.ds-input:hover{border-color:var(--ink-3,#6B8290)}.ds-input:focus,.ds-input:focus-visible{border-color:var(--ocean-2,#126C8F)}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "rail-nav-active",
      "description": "Ocean rail with member faces and icon-over-label view buttons.",
      "html": "<nav class=\"ds-rail\"><span class=\"ds-face on\" style=\"--c:#2F7BB5\">A</span><span class=\"ds-face\" style=\"--c:#7B5EA7\">S</span><hr><button class=\"ds-nav on\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z\"/></svg>Home</button><button class=\"ds-nav\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M4 10h16M9 3v4M15 3v4\"/></svg>Calendar</button></nav>",
      "css": ".ds-rail{width:92px;background:var(--ocean,#0B4F6C);color:var(--ocean-ink,#E6F2F7);display:flex;flex-direction:column;align-items:center;gap:8px;padding:18px 0;font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif)}.ds-rail hr{width:60px;border:0;border-top:1px solid rgba(230,242,247,.14);margin:6px 0}.ds-face{width:56px;height:56px;border-radius:50%;border:3px solid transparent;display:grid;place-items:center;font-weight:700;font-size:22px;color:#fff;background:var(--c);transition:transform .2s cubic-bezier(.2,.8,.2,1)}.ds-face.on{border-color:var(--apricot,#F2A65A);transform:scale(1.06)}.ds-nav{width:68px;min-height:62px;border:0;border-radius:18px;background:transparent;color:var(--ocean-ink-2,#9CC3D3);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer;transition:background .2s,color .2s}.ds-nav:hover{color:var(--ocean-ink,#E6F2F7)}.ds-nav.on{background:rgba(230,242,247,.13);color:#fff}.ds-nav:focus-visible{outline:3px solid var(--ocean-2,#126C8F);outline-offset:2px}"
    },
    {
      "name": "Reminder Chip",
      "kind": "chip",
      "refersTo": "chip-reminder",
      "description": "Bin night, countdowns and school terms under the sky.",
      "html": "<span class=\"ds-chip\"><b style=\"--c:#7B5EA7\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"9\" width=\"16\" height=\"11\" rx=\"1\"/><path d=\"M3 9h18M12 9v11M12 9c-2-4-6-4-6-1s6 1 6 1 6 2 6-1-4-3-6 1\"/></svg></b>Christmas <em>36 sleeps</em></span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:10px;padding:8px 16px 8px 8px;border-radius:99px;background:var(--surface,#F8FBFC);box-shadow:var(--shadow,0 1px 2px rgba(0,0,0,.06),0 10px 28px -14px rgba(0,0,0,.22));font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif);font-weight:650;font-size:16.5px;color:var(--ink,#10293A)}.ds-chip b{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;color:#fff;background:var(--c)}.ds-chip em{font-style:normal;color:var(--ink-2,#46606F);font-weight:600}"
    },
    {
      "name": "Zone",
      "kind": "card",
      "refersTo": "zone",
      "description": "Foam field on sea-mist with the single field lift; title plus ocean text link.",
      "html": "<section class=\"ds-zone\"><h2>Up next <button>Week</button></h2><div class=\"ds-ev\"><span class=\"ds-when\">3:30pm</span><span class=\"ds-what\">Swimming</span></div><div class=\"ds-ev\"><span class=\"ds-when plain\">5:30pm</span><span class=\"ds-what\">Pick up groceries</span></div></section>",
      "css": ".ds-zone{background:var(--surface,#F8FBFC);border-radius:22px;box-shadow:var(--shadow,0 1px 2px rgba(0,0,0,.06),0 10px 28px -14px rgba(0,0,0,.22));padding:20px 22px;font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif);color:var(--ink,#10293A);max-width:420px}.ds-zone h2{margin:0 0 12px;font-size:21px;font-weight:700;letter-spacing:-.01em;display:flex;align-items:center}.ds-zone h2 button{margin-left:auto;font:inherit;font-size:15px;font-weight:600;color:var(--ocean-2,#126C8F);background:none;border:0;padding:6px 4px;cursor:pointer}.ds-zone h2 button:hover{text-decoration:underline}.ds-zone h2 button:focus-visible{outline:3px solid var(--ocean-2,#126C8F);outline-offset:2px;border-radius:10px}.ds-ev{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line,rgba(0,0,0,.1));font-variant-numeric:tabular-nums}.ds-ev:last-child{border-bottom:0}.ds-when{font-weight:700;font-size:17px;min-width:76px;text-align:center;color:var(--apricot-ink,#7A4210);background:color-mix(in srgb,var(--apricot,#F2A65A) 28%,transparent);padding:6px 10px;border-radius:12px}.ds-when.plain{background:none;color:var(--ink-2,#46606F);text-align:left;padding:0}.ds-what{font-size:21px;font-weight:650;line-height:1.2}"
    },
    {
      "name": "Sticky Note",
      "kind": "custom",
      "refersTo": "note",
      "description": "Tilted pale paper on the notes board.",
      "html": "<div class=\"ds-note\">Plumber coming Thursday. Leave the side gate open.<span>Sam</span></div>",
      "css": ".ds-note{position:relative;width:200px;border-radius:16px;padding:14px 38px 30px 16px;font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif);font-size:18px;font-weight:600;line-height:1.3;color:#2B2416;background:#F6E2A0;box-shadow:0 1px 1px rgba(0,0,0,.05),0 8px 18px -12px rgba(0,0,0,.35);transform:rotate(-1.2deg);min-height:110px;transition:transform .2s}.ds-note:hover{transform:rotate(0deg)}.ds-note span{position:absolute;left:16px;bottom:9px;font-size:13px;font-weight:700;opacity:.65}"
    },
    {
      "name": "Sky Band",
      "kind": "custom",
      "refersTo": "sky-pill",
      "description": "Signature: time-tinted sky with clock, horizon, sun at now and stemmed event pills.",
      "html": "<section class=\"ds-sky\"><div class=\"ds-clock\">3:05<small>pm</small></div><div class=\"ds-sun\"></div><div class=\"ds-hz\"><i class=\"ds-line\"></i><i class=\"ds-past\"></i><i class=\"ds-stem\"></i><i class=\"ds-mark\"></i><button class=\"ds-pill\"><b>R</b>3:30pm Swimming</button></div></section>",
      "css": ".ds-sky{position:relative;height:260px;overflow:hidden;color:#fff;background:linear-gradient(180deg,#4E9BD0,#D6EBF4);font-family:var(--font,Nunito,ui-rounded,system-ui,sans-serif)}.ds-clock{position:absolute;left:22px;top:18px;font-size:88px;font-weight:650;letter-spacing:-.035em;line-height:.92;text-shadow:0 2px 10px rgba(0,0,0,.14);font-variant-numeric:tabular-nums}.ds-clock small{font-size:.3em;font-weight:600;letter-spacing:0;margin-left:.15em;opacity:.85}.ds-sun{position:absolute;left:55%;bottom:110px;width:46px;height:46px;margin-left:-23px;border-radius:50%;background:radial-gradient(circle at 40% 38%,#FFF4D6,#FFD08A 55%,#F2A65A);box-shadow:0 0 60px 30px rgba(255,214,150,.35)}.ds-hz{position:absolute;left:22px;right:22px;bottom:16px;height:110px}.ds-line,.ds-past{position:absolute;left:0;bottom:24px;height:2px;border-radius:2px}.ds-line{right:0;background:rgba(255,255,255,.55)}.ds-past{width:55%;background:#fff}.ds-stem{position:absolute;left:62%;bottom:26px;width:2px;height:12px;background:rgba(255,255,255,.85)}.ds-mark{position:absolute;left:62%;bottom:18px;width:16px;height:16px;margin-left:-8px;border-radius:50%;background:#D49A12;border:3px solid #fff;box-shadow:0 0 0 3px #F2A65A}.ds-pill{position:absolute;left:58%;bottom:38px;height:40px;display:flex;align-items:center;gap:8px;padding:0 14px 0 6px;border:0;border-radius:99px;background:rgba(255,255,255,.92);color:var(--ink,#10293A);font:inherit;font-size:15.5px;font-weight:650;box-shadow:0 0 0 3px #F2A65A,0 6px 18px -8px rgba(0,0,0,.45);cursor:pointer}.ds-pill b{width:28px;height:28px;border-radius:50%;background:#D49A12;color:#fff;display:grid;place-items:center;font-size:12px}.ds-pill:focus-visible{outline:3px solid var(--ocean-2,#126C8F);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Today Is a Sky",
    "overview": "**Creative North Star: \"Today Is a Sky\"**\n\nSkylike is a Perth coastal morning turned into a family calendar. The top of every home view is the real day's sky, 6am to 9pm, painted by the actual hour: dawn violet, midday Indian Ocean blue, apricot sunset, dusk navy. A sun (a moon after dark) sits at now; the family's events stand on its horizon as white pills tied by stems to colour marks on the timeline. Everything below the horizon is calm ground: sea-mist, limestone-sand accents, soft rounded fields with almost no lines.\n\nThe system is built for glancing from across a hallway. Numerals are huge and tabular, type is a single rounded face in heavy weights, and each screen carries a few large things rather than many small ones. Colour is spent on people (each family member owns a flora colour) and on now (apricot); structure is carried by tone and soft shadow, not borders. At night the whole palette is swapped, not dimmed: ground, surfaces, rail and type move to low-luminance dusk navy and family colours desaturate, so the screen never glows in a dark room.\n\nIt rejects the category default of white cards over a colour-coded agenda grid, and it rejects dashboard density and cold, techy chrome.",
    "keyCharacteristics": [
      "A live sky band whose gradient follows the true time of day, with sun or moon at now.",
      "One rounded face (Nunito, self-hosted variable) at 600-750 weight; tabular numerals for every time.",
      "Deep ocean rail on the left (tablet) or a sea-mist tab bar (phone); everything else floats on sea-mist ground.",
      "Generous radius everywhere, pill shapes for anything tappable-and-small, soft offset shadows, near-zero borders.",
      "Family colours from local flora identify people; apricot means now.",
      "A full night palette swap at low luminance, plus a near-black idle clock."
    ],
    "rules": [
      {
        "name": "The Apricot Means Now Rule",
        "body": "Apricot marks the present moment, the person whose view this is, or time pressure. It never decorates, and no second warm accent competes with it.",
        "section": "colors"
      },
      {
        "name": "The People Own Colour Rule",
        "body": "Flora colours identify a family member and nothing else. Chrome, headings and controls stay ocean and ink; a reminder chip borrows a flora disc only as the badge behind its icon.",
        "section": "colors"
      },
      {
        "name": "The Swap, Don't Dim Rule",
        "body": "Night is a separate palette at low luminance, not an opacity layer over the day palette.",
        "section": "colors"
      },
      {
        "name": "The One Face Rule",
        "body": "Nunito carries every role. Monospace appears only where a person must copy characters exactly.",
        "section": "typography"
      },
      {
        "name": "The Tabular Time Rule",
        "body": "Every time, count and temperature uses tabular numerals so the clock never jitters and columns of times align.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels and group tags are sentence case at normal tracking; nothing is uppercase-spaced.",
        "section": "typography"
      },
      {
        "name": "The One Lift Rule",
        "body": "Every resting field uses the same field-lift shadow. Depth differences come from tone, not from stacking more shadow.",
        "section": "elevation"
      },
      {
        "name": "The Ring For State Rule",
        "body": "Selection and now are 3px rings (apricot for now, ink for chosen swatch, ocean-bright for focus), never heavier shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** open every home view with the live sky band and keep its gradient tied to the true time of day.",
      "**Do** keep apricot for now, the active person, and time pressure; use the now ring (3px apricot) to mark today.",
      "**Do** identify people with their flora colour on faces, dots, marks and tints, and pair kid-facing items with an icon or emoji avatar so pre-readers can follow.",
      "**Do** use one field-lift shadow on foam fields over sea-mist ground, with hairlines only between rows.",
      "**Do** set every time in tabular numerals and keep headings at 650-750 weight in the one rounded face.",
      "**Do** swap to the night palette after dark rather than lowering opacity.",
      "**Do** keep touch targets at least 48px and honour safe-area insets."
    ],
    "donts": [
      "**Don't** build white cards over a colour-coded agenda grid; that is the category default this system replaces.",
      "**Don't** add borders around fields or stack heavier shadows for emphasis; use tone or a ring.",
      "**Don't** use flora colours for chrome, headings or decoration.",
      "**Don't** introduce a second display face, or use monospace anywhere but codes to be typed.",
      "**Don't** add uppercase tracked labels or small category tags above headings.",
      "**Don't** put bright white or saturated fields on screen at night."
    ]
  }
}